[Unit]
Description=Update Cairn from its apt repository
Documentation=https://github.com/dkjsiogu/cairn/blob/main/docs/design/26-auto-update.md
ConditionPathExists=/etc/apt/apt.conf.d/52cairn-auto-update
ConditionPathExists=/etc/apt/sources.list.d/cairn.sources
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/cairn/update
Nice=10
IOSchedulingClass=idle
