#!/bin/sh
# Add the Cairn apt source, daily unattended upgrades and an hourly update timer.
#
# The source and the unattended-upgrades setting are added on a fresh install,
# or when upgrading from a version without them (before 0.41.0). The timer is
# enabled on a fresh install, or when upgrading from a version without it
# (before 0.42.2). If the player deletes either file or disables the timer
# later, upgrades leave that choice alone.
set -e

share=/usr/share/cairn/apt
sources=/etc/apt/sources.list.d/cairn.sources
auto=/etc/apt/apt.conf.d/52cairn-auto-update

if [ "$1" = configure ]; then
  if [ -z "$2" ] || dpkg --compare-versions "$2" lt 0.41.0; then
    # Skip the source if the player already added the same repository.
    if ! grep -rqsF 'dkjsiogu.github.io/cairn/apt' /etc/apt/sources.list /etc/apt/sources.list.d/; then
      install -m 644 "$share/cairn.sources" "$sources"
    fi
    if [ ! -e "$auto" ]; then
      install -m 644 "$share/52cairn-auto-update" "$auto"
    fi
  fi
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    if [ -z "$2" ] || dpkg --compare-versions "$2" lt 0.42.2; then
      systemctl enable --now cairn-update.timer >/dev/null 2>&1 || true
    fi
  fi
fi

exit 0
